{
  "manifest_version": 3,
  "name": "Fact or Fiction: Credibility Lens",
  "version": "1.0.0",
  "description": "Explains credibility-related language, source and discussion signals on Reddit posts.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://www.reddit.com/*",
    "https://old.reddit.com/*",
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Fact or Fiction",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.reddit.com/*", "https://old.reddit.com/*"],
      "js": ["content/contentScript.js"],
      "run_at": "document_idle"
    }
  ]
}
