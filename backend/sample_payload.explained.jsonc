// EXPLANATORY COPY ONLY: JSONC supports comments; the matching .json file
// remains the executable/valid file used by Chrome, Node or Flask.

{
  // Original/source URL associated with the Reddit post.
  "url": "https://www.reddit.com/r/example/comments/example/example_post/",
  // Captured Reddit post title.
  "title": "A cautious example claim with linked data",
  // Captured self-text/body analysed together with the title.
  "body": "According to the published report, the estimate may change as more data becomes available. Source: https://example.org/report",
  // Structured sample comments; author is optional, score/depth are metadata.
  "comments": [
    {
      "text": "The methodology is described in the linked report.",
      "score": 12,
      "depth": 0
    },
    {
      "text": "Do you have another source for this claim?",
      "score": 4,
      "depth": 0
    }
  ],
  // Diagnostic details describing how the extension captured the data.
  "extraction": {
    "method": "sample",
    "commentsCaptured": 2
  }
}
